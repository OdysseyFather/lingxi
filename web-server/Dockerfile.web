# ─── 灵犀 Web 多用户版 Docker 构建 ─────────────────────────────
# 多阶段：backend-web + web-gateway + frontend-web
#
# 构建（项目根目录）:
#   docker build -f web-server/Dockerfile.web -t lingxi-web .
#
# 或配合 docker-compose.web.yml:
#   cd web-server && docker compose -f docker-compose.web.yml up -d --build

# ─── 阶段 1: 编译 backend-web ─────────────────────────────────
FROM golang:1.24-alpine AS backend-builder
RUN apk add --no-cache git
WORKDIR /build
COPY go.work ./
COPY backend-core/ ./backend-core/
COPY backend-desktop/ ./backend-desktop/
COPY backend-web/ ./backend-web/
WORKDIR /build/backend-web
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /smart-agent .

# ─── 阶段 2: 编译 Web 网关 ───────────────────────────────────
FROM golang:1.24-alpine AS gateway-builder
WORKDIR /build
COPY web-server/go.mod web-server/go.sum ./
RUN go mod download
COPY web-server/ .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /web-gateway .

# ─── 阶段 3: 构建 frontend-web ────────────────────────────────
FROM node:22-alpine AS frontend-builder
WORKDIR /build
COPY frontend-web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend-web/ .
RUN npm run build

# ─── 阶段 4: 运行时 ───────────────────────────────────────────
FROM node:22-alpine

# 技能依赖安装失败必须阻断构建，不能被下方 CLI 安装的容错逻辑吞掉。
RUN apk add --no-cache python3 py3-requests py3-openpyxl
COPY web-server/check-skill-python.py /usr/local/lib/lingxi/check-skill-python.py
RUN python3 /usr/local/lib/lingxi/check-skill-python.py

RUN apk add --no-cache bash curl && \
    npm install -g @anthropic-ai/claude-code 2>/dev/null || true && \
    npm cache clean --force

WORKDIR /app

COPY --from=backend-builder /smart-agent ./smart-agent
COPY --from=gateway-builder /web-gateway ./web-gateway
COPY --from=frontend-builder /build/dist ./dist
COPY web-server/static ./static

RUN mkdir -p /data/uploads /data/knowledge /data/users

ENV DATA_DIR=/data
ENV FRONTEND_DIST=./dist
ENV BACKEND_BIN=./smart-agent
ENV PORT=3000
ENV BACKEND_PORT=13001

EXPOSE 3000
VOLUME ["/data"]

CMD ["./web-gateway"]
